prefix=/home/isc/tk2_ws/build/libcamera
includedir=${prefix}/include
libdir=${prefix}/lib
srcdir=/home/isc/tk2_ws/src/libcamera

Name: libcamera
Description: Complex Camera Support Library
Version: 0.7.2
Requires: libcamera-base
Libs: -L${prefix}/src/libcamera -lcamera
Cflags: -I${prefix}/include -I${srcdir}/include -I${prefix}/subprojects/libpisp/src -I${srcdir}/subprojects/libpisp/src -I${prefix}/subprojects/libpisp/src/libpisp -I${srcdir}/subprojects/libpisp/src/libpisp -I${prefix}/subprojects/libyuv/__CMake_build -I${srcdir}/subprojects/libyuv/__CMake_build -I${prefix}/subprojects/libyuv -I${srcdir}/subprojects/libyuv -I${prefix}/subprojects/libyuv/include -I${srcdir}/subprojects/libyuv/include -I${prefix}/src/libcamera -I${srcdir}/src/libcamera
